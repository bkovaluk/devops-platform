# Copy to .env for local overrides. Every value here is the default unless noted.

APP_NAME=DevOps Platform
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Ordered lowest to highest. Changes in DIRECT_ENVS apply at once; anywhere
# else they become approval requests.
ENVIRONMENTS=dev,staging,prod
DIRECT_ENVS=dev

# dev: every request is DEV_USER_EMAIL, holding DEV_USER_ROLES. Local only.
AUTH_MODE=dev
DEV_USER_EMAIL=ada@example.com
DEV_USER_NAME=Ada
DEV_USER_ROLES=admin

# oidc: verify the bearer ID token. Google Workspace example:
# AUTH_MODE=oidc
# OIDC_ISSUER=https://accounts.google.com
# OIDC_AUDIENCE=<your OAuth client id>
# OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# OIDC_HOSTED_DOMAIN=example.com

# Who holds which role; anyone unlisted holds DEFAULT_ROLES.
ROLE_BINDINGS={"grace@example.com": ["editor", "reviewer"], "alan@example.com": ["reviewer"]}
DEFAULT_ROLES=viewer
# Extra roles beside viewer/editor/reviewer/admin. Scopes may name an env.
CUSTOM_ROLES={"dev-editor": ["flags:read", "flags:write:dev"]}

APPROVAL_TTL_HOURS=72

# memory (default, seeded with examples) or dynamodb.
STORE=memory
SEED_EXAMPLE_DATA=true
DYNAMODB_TABLE=devops-platform
AWS_REGION=us-east-1
# Point boto3 at DynamoDB Local instead of AWS:
# AWS_ENDPOINT_URL=http://localhost:8001

# Optional cross-account roles for tools that call AWS per environment.
AWS_ROLE_ARNS={}

# The assistant behind POST /api/agent: a Pydantic AI model string. Unset turns
# it off (the route answers 503 and the UI hides it). The provider reads its
# credentials from the process environment, not from this file.
# Anthropic (export ANTHROPIC_API_KEY):
# AGENT_MODEL=anthropic:claude-sonnet-4-5
# Amazon Bedrock (AWS credentials from the usual chain, plus AWS_REGION):
# AGENT_MODEL=bedrock:us.anthropic.claude-sonnet-4-5-20250929-v1:0
