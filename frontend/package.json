{
  "name": "devops-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "generate-api-types": "node --import ./scripts/api-types/typescript5.ts node_modules/openapi-typescript/bin/cli.js ../backend/openapi.json --output src/types/api-generated.ts",
    "check-api-types": "bun run generate-api-types --check",
    "generate-scope-contract": "cp ../scope-contract.json src/features/auth/scope-contract.json",
    "check-scope-contract": "bun run generate-scope-contract && git diff --exit-code src/features/auth/scope-contract.json",
    "registry:build": "bun scripts/registry/build.ts",
    "screenshots": "bun scripts/screenshots/sweep.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/hubot-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "storybook": "10.6.3",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
